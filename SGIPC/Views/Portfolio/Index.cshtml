@model SGIPC.Models.HomePageViewModel
@{
    ViewBag.Title = "SGIPC Portfolio";
    Layout = "~/Views/Portfolio/_Layout.cshtml";
}
<link rel="stylesheet" href='@Url.Content("~/Content/Portfolio/main.css")'>

<!-- Hero Section -->
<section id="home" class="hero">
    <h1 id="hero-title">
        <span id="hero-typed"></span><span class="hero-cursor"></span>
    </h1>
    <p id="hero-sub">Empowering programmers | Building problem solvers</p>
    <span id="hero-btns">
        <button class="login" onclick="window.location.href='@Url.Action("Signin", "Portfolio")'">Sign in</button>
        <button class="login" onclick="window.location.href='@Url.Action("Signup", "Portfolio")'">Sign up</button>
    </span>
</section>

@if (TempData["SuccessMessage"] != null)
{
    <div style="background-color: #10b981; color: white; padding: 16px 24px; margin: 20px 40px; border-radius: 8px; text-align: center; font-weight: 500; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);">
        &#10003; @TempData["SuccessMessage"]
    </div>
}

<!-- About SGIPC Section -->
<section id="about" class="about">
    <div class="about-inner fade-up">
        <h2>About SGIPC</h2>
        <p class="about-desc">
            <b>SGIPC</b> (Special Group Interested in Programming Contest) is the
            official competitive programming club of KUET's CSE department. We focus on
            competitive programming, algorithmic thinking, and ICPC preparation. We help
            students grow from beginner to advanced through structured practice and mentorship.
        </p>
        <div class="about-stats">
            <div class="stat-box fade-up delay-1">
                <span class="stat-num">100+</span>
                <span class="stat-label">Members</span>
            </div>
            <div class="stat-box fade-up delay-2">
                <span class="stat-num">Frequent</span>
                <span class="stat-label">Contests</span>
            </div>
            <div class="stat-box fade-up delay-3">
                <span class="stat-num">Weekly</span>
                <span class="stat-label">Workshops</span>
            </div>
            <div class="stat-box fade-up delay-4">
                <span class="stat-num">10+</span>
                <span class="stat-label">Years Active</span>
            </div>
        </div>
    </div>
</section>

<!-- Feature Section -->
<section class="features">
    <div class="card fade-up delay-1">
        <h3>Competitive Programming</h3>
        <p>Practice Codeforces, AtCoder & ICPC-style problems.</p>
    </div>
    <div class="card fade-up delay-2">
        <h3>Workshops</h3>
        <p>Learn algorithms, data structures, and problem solving.</p>
    </div>
    <div class="card fade-up delay-3">
        <h3>Team Practice</h3>
        <p>Mock contests and collaborative learning.</p>
    </div>
</section>

<!-- Events Section -->
<section id="events" class="events">
    <div class="section-heading">
        <div>
            <h2>Events</h2>
            <p>Weekly contests, workshops, and ICPC preparation sessions.</p>
        </div>
    </div>
    <div class="event-grid">
        @if (Model.Events.Count == 0)
        {
            <div class="empty-card">No events are scheduled at the moment. Check back soon.</div>
        }
        else
        {
            foreach (var evt in Model.Events)
            {
                <div class="event-card @(evt.Status.ToLower())">
                    <div class="event-chip">@evt.Status</div>
                    <h3>@evt.Title</h3>
                    <p class="event-meta">
                        <span>@evt.Date.ToString("dd MMM yyyy")</span>
                        @if (!string.IsNullOrWhiteSpace(evt.STime))
                        {
                            <span>
                                @evt.STime
                                @if (!string.IsNullOrWhiteSpace(evt.ETime))
                                {
                                    <text> - @evt.ETime</text>
                                }
                            </span>
                        }
                    </p>
                    <p class="event-location">@evt.Location</p>
                    <p class="event-description">@evt.Description</p>
                </div>
            }
        }
    </div>
</section>

<!-- Achievement Section -->
<section id="achievements" class="achievements">
    <div class="ach-header">
        <h2>Achievements</h2>
        <p>Proud moments from our competitive programming journey</p>
    </div>

    <div class="ach-carousel">
        <button class="ach-btn" id="achPrev">&#10094;</button>

        <div class="ach-window">
            <div class="ach-track" id="achTrack">

                <div class="ach-card">
                    <div class="ach-img-wrap">
                        <img src="@Url.Content("~/Content/Portfolio/images/buet_iupc_26.jpg")" alt="BUET IUPC 2026" class="ach-img" onerror="this.style.display='none';this.parentElement.classList.add('no-img')">
                    </div>
                    <div class="ach-body">
                        <div class="ach-contest">BUET IUPC 2026</div>
                        <div class="ach-result">Ranked 4th Place</div>
                        <div class="ach-team-name">KUET_Potol</div>
                        <div class="ach-members">
                            <span>Khadimul Islam Mahi</span>
                            <span>Dipra Datta</span>
                            <span>Md Abu Daud Sharif</span>
                        </div>
                    </div>
                </div>

                <div class="ach-card">
                    <div class="ach-img-wrap">
                        <img src="@Url.Content("~/Content/Portfolio/images/icpc_reg_25.jpg")" alt="ICPC Regional 2025" class="ach-img" onerror="this.style.display='none';this.parentElement.classList.add('no-img')">
                    </div>
                    <div class="ach-body">
                        <div class="ach-contest">ICPC Regional 2025</div>
                        <div class="ach-result">Ranked 19th Place</div>
                        <div class="ach-team-name">KUET_Potol</div>
                        <div class="ach-members">
                            <span>Khadimul Islam Mahi</span>
                            <span>Dipra Datta</span>
                            <span>Md Abu Daud Sharif</span>
                        </div>
                    </div>
                </div>

                <div class="ach-card">
                    <div class="ach-img-wrap">
                        <img src="@Url.Content("~/Content/Portfolio/images/nwu_cse_fest_25.jpg")" alt="ICPC World Finals 2024" class="ach-img" onerror="this.style.display='none';this.parentElement.classList.add('no-img')">
                    </div>
                    <div class="ach-body">
                        <div class="ach-contest">NWU CSE Fest 2025</div>
                        <div class="ach-result">Champion</div>
                        <div class="ach-team-name">KUET_Potol</div>
                        <div class="ach-members">
                            <span>Khadimul Islam Mahi</span>
                            <span>Dipra Datta</span>
                            <span>Md Abu Daud Sharif</span>
                        </div>
                    </div>
                </div>

                <div class="ach-card">
                    <div class="ach-img-wrap">
                        <img src="@Url.Content("~/Content/Portfolio/images/icpc_wf_24.jpg")" alt="NWU CSE Fest 2025" class="ach-img" onerror="this.style.display='none';this.parentElement.classList.add('no-img')">
                    </div>
                    <div class="ach-body">
                        <div class="ach-contest">ICPC World Finals 2024</div>
                        <div class="ach-result">Ranked 115th Place</div>
                        <div class="ach-team-name">KUET_Effervescent</div>
                        <div class="ach-members">
                            <span>Arnob Sarker</span>
                            <span>Sharif Minhazul Islam</span>
                            <span>Md Mehrab Hossain Opi</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <button class="ach-btn" id="achNext">&#10095;</button>
    </div>

    <!-- Dots -->
    <div class="ach-dots" id="achDots"></div>
</section>

<!-- Become a Member Section -->
<section id="join" class="join">
    <div class="join-inner">
        <h2>Become a Member</h2>
        <p>
            Ready to level up your competitive programming journey? <br>
            Apply to join SGIPC - applications are reviewed and approved by our admin team.
        </p>
        <ul class="join-perks">
            <li>&#x1F3C6 Access to exclusive contests & practice sets</li>
            <li>&#x1F9E0 Mentorship from senior competitive programmers</li>
            <li>&#x1F4C5 Invitations to workshops and ICPC prep sessions</li>
            <li>&#x1F91D Be part of a thriving programming community</li>
        </ul>
        <div>
            <button class="btn-join" onclick="window.location.href='@Url.Action("Form", "Portfolio")'">Apply Now</button>
        </div>
    </div>
</section>

<!-- Contact Section -->
<section id="contact" class="contact">
    <div class="contact-container">
        <div class="contact-left">
            <h2>Get In Touch</h2>

            <p>SGIPC - Special Group Interested in Programming Contest</p>
            <p>New Academic Building ( Block B )</p>
            <p>Department of Computer Science and Engineering</p>
            <p>Khulna University of Engineering & Technology (KUET)</p>
            <p>Khulna-9203, Bangladesh</p>

            <br>

            <div class="contact-actions">
                <button class="btn-contact" onclick="window.location.href='@Url.Action("Contact", "Portfolio")'">
                    Contact Us
                </button>

                <a href="https://www.facebook.com/sgipc.kuet/" target="_blank" class="btn-contact social-btn fb">
                    Facebook
                </a>

                <a href="https://linkedin.com/company/sgipc-kuet" target="_blank" class="btn-contact social-btn linkedin">
                    LinkedIn
                </a>
            </div>

            <div class="quick-links">
                <a href="@Url.Action("Index", "Portfolio")#home" class="quick-link-btn">Home</a>
                <a href="@Url.Action("Index", "Portfolio")#about" class="quick-link-btn">About</a>
                <a href="@Url.Action("Committee", "Portfolio")" class="quick-link-btn">Committee</a>
                <a href="@Url.Action("Index", "Portfolio")#events" class="quick-link-btn">Events</a>
                <a href="@Url.Action("Announcements", "Portfolio")" class="quick-link-btn">Announcements</a>
                <a href="@Url.Action("Resources", "Portfolio")" class="quick-link-btn">Resources</a>
                <a href="@Url.Action("Index", "Portfolio")#achievements" class="quick-link-btn">Achievements</a>
                <a href="@Url.Action("Index", "Portfolio")#join" class="quick-link-btn">Join</a>
            </div>
        </div>

        <div class="contact-right">
            <h3>Department of CSE, KUET</h3>
            <div class="contact-map">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d918.8469898524471!2d89.50106102581306!3d22.899056998515764!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x39ff9bd9f4494d21%3A0xc2e2f69b4b04b9f4!2sDepartment%20of%20Computer%20Science%20and%20Engineering!5e0!3m2!1sen!2sbd!4v1778603272295!5m2!1sen!2sbd" width="100" height="500" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        </div>
    </div>
</section>

<script src="@Url.Content("~/Scripts/Portfolio/main.js")"></script>
