@model List<SGIPC.Models.ResourceViewModel>
@{
    ViewBag.Title = "Resources";
    Layout = "~/Views/Portfolio/_Layout.cshtml";
}
<link rel="stylesheet" href='@Url.Content("~/Content/Portfolio/main.css")'>

<section class="page-banner">
    <div class="page-banner-content">
        <h1>Resources</h1>
        <p>Download Study materials and necessary files provided by SGIPC</p>
    </div>
</section>

<section class="cards-section">
    @if (Model.Count == 0)
    {
        <div class="empty-card">No resources are available yet. Check back soon for new uploads.</div>
    }
    else
    {
        <div class="card-grid">
            @foreach (var resource in Model)
            {
                <article class="info-card resource-card-public">
                    <div class="card-head">
                        <h2>@resource.Title</h2>
                        <span>@resource.CreatedAt.ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="resource-card-body">
                        <p class="resource-desc">@resource.Description</p>
                        @if (!resource.MediaType.StartsWith("image/") && !resource.MediaType.StartsWith("video/"))
                        {
                            <div class="resource-action-row">
                                <a class="btn btn-download" href="@Url.Action("ResourceFile", "Portfolio", new { id = resource.Id })" title="Download @resource.FileName">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2"
                                        stroke-linecap="round" stroke-linejoin="round"
                                        style="margin-right:6px; vertical-align:middle;">
                                        <circle cx="12" cy="12" r="10"/>
                                        <line x1="12" y1="8" x2="12" y2="16"/>
                                        <polyline points="8 12 12 16 16 12"/>
                                    </svg>
                                    Download
                                </a>
                            </div>
                        }
                    </div>
                    <div class="resource-preview">
                        @if (resource.MediaType.StartsWith("image/"))
                        {
                            <img src="@Url.Action("ResourceFile", "Portfolio", new { id = resource.Id })" alt="@resource.Title" />
                        }
                        else if (resource.MediaType.StartsWith("video/"))
                        {
                            <video controls src="@Url.Action("ResourceFile", "Portfolio", new { id = resource.Id })"></video>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>
