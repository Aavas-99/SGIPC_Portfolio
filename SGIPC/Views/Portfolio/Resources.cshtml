@model List<SGIPC.Models.ResourceViewModel>
@{
    ViewBag.Title = "Resources";
    Layout = "~/Views/Portfolio/_Layout.cshtml";
}
<link rel="stylesheet" href='@Url.Content("~/Content/Portfolio/main.css")'>

<section class="page-banner">
    <div class="page-banner-content">
        <h1>Resources</h1>
        <p>Download study materials and view club images and video resources.</p>
    </div>
</section>

<section class="cards-section">
    @if (Model.Count == 0)
    {
        <div class="empty-card">No resources are available yet. Check back soon for new uploads.</div>
    }
    else
    {
        <div class="card-grid">
            @foreach (var resource in Model)
            {
                <article class="info-card resource-card-public">
                    <div class="card-head">
                        <h2>@resource.Title</h2>
                        <span>@resource.CreatedAt.ToString("dd MMM yyyy")</span>
                    </div>
                    <p>@resource.Description</p>
                    <div class="resource-preview">
                        @if (resource.MediaType.StartsWith("image/"))
                        {
                            <img src="@Url.Action("ResourceFile", "Portfolio", new { id = resource.Id })" alt="@resource.Title" />
                        }
                        else if (resource.MediaType.StartsWith("video/"))
                        {
                            <video controls src="@Url.Action("ResourceFile", "Portfolio", new { id = resource.Id })"></video>
                        }
                        else
                        {
                            <a class="btn" href="@Url.Action("ResourceFile", "Portfolio", new { id = resource.Id })">Download</a>
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>
