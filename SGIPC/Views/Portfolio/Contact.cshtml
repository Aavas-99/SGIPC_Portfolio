        document.addEventListener("DOMContentLoaded", function () {
            document.getElementById("successModal").style.display = "flex";
        });
    </script>
} -->

@if (TempData["SuccessMessage"] != null)
{
    <script>
        alert('TempData is working');
        document.addEventListener("DOMContentLoaded", function () {
            document.getElementById("successModal").style.display = "flex";
        });
    </script>
}

</body>
</html>