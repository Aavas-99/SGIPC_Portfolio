@model SGIPC.Models.ChangePasswordViewModel
@{
    ViewBag.Title = "Change Password";
    Layout = null;
    var userEmail = Session["UserEmail"]?.ToString() ?? "";
    if (string.IsNullOrEmpty(userEmail) && User.Identity.IsAuthenticated)
    {
        userEmail = User.Identity.Name ?? "";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - SGIPC</title>
    <link rel="icon" type="image/jpg" href='@Url.Content("~/Content/Portfolio/images/SGIPC.jpg")' />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
<header>
    <div class="logo">
        <img src='@Url.Content("~/Content/Portfolio/images/SGIPC.png")' alt="SGIPC Logo" />
        <h2>SGIPC</h2>
    </div>
    <nav>
        <a href='@Url.Action("Index", "Portfolio")#home'>Home</a>
        <a href='@Url.Action("Index", "Portfolio")#about'>About</a>
        <a href='@Url.Action("Committee", "Portfolio")'>Committee</a>
        <a href='@Url.Action("Index", "Portfolio")#events'>Events</a>
        <a href='@Url.Action("Announcements", "Portfolio")'>Announcements</a>
        <a href='@Url.Action("Resources", "Portfolio")'>Resources</a>
        <a href='@Url.Action("Index", "Portfolio")#achievements'>Achievements</a>
        <a href='@Url.Action("Index", "Portfolio")#join'>Join</a>
        <a href='@Url.Action("Index", "Portfolio")#contact'>Contact</a>
        @if (!string.IsNullOrEmpty(userEmail))
        {
            <div class="user-menu-dropdown">
                <button class="user-menu-btn">
                    <svg class="user-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    <span class="user-name">@userEmail.Split('@')[0]</span>
                </button>
                <div class="dropdown-menu">
                    <div class="dropdown-header">@userEmail</div>
                    <a href='@Url.Action("ChangePassword", "Portfolio")' class="dropdown-item">Change Password</a>
                    <a href='@Url.Action("Logout", "Portfolio")' class="dropdown-item">Logout</a>
                </div>
            </div>
        }
    </nav>
</header>
<main class="password-page">
    <div class="password-card">
        <h1>Change Password</h1>
        <p class="subtitle">Update your account password securely.</p>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="success-box">@TempData["SuccessMessage"]</div>
        }

        @using (Html.BeginForm("ChangePassword", "Portfolio", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Count > 0)
            {
                <div class="validation-summary-errors">
                    <h3>Please fix the following errors:</h3>
                    @Html.ValidationSummary(false)
                </div>
            }

            <div class="form-group">
                <label>Current Password</label>
                @Html.PasswordFor(m => m.CurrentPassword, new { @placeholder = "Current password", @class = "form-input", @required = "required" })
                @Html.ValidationMessageFor(m => m.CurrentPassword, "", new { @class = "err-msg" })
            </div>

            <div class="form-group">
                <label>New Password</label>
                @Html.PasswordFor(m => m.NewPassword, new { @placeholder = "New password", @class = "form-input", @required = "required" })
                @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "err-msg" })
            </div>

            <div class="form-group">
                <label>Confirm New Password</label>
                @Html.PasswordFor(m => m.ConfirmNewPassword, new { @placeholder = "Confirm new password", @class = "form-input", @required = "required" })
                @Html.ValidationMessageFor(m => m.ConfirmNewPassword, "", new { @class = "err-msg" })
            </div>

            <button type="submit" class="btn-submit">Update Password</button>
        }
    </div>
</main>
<style>
    body {
        margin: 0;
        font-family: 'Inter', sans-serif;
        background: #f7f9fc;
        color: #1f2937;
    }
    header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 32px;
        background: #0f172a;
        color: #fff;
    }
    header .logo {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    header .logo img {
        width: 42px;
        height: 42px;
    }
    header .logo h2 {
        margin: 0;
        font-size: 20px;
        letter-spacing: 0.05em;
    }
    nav {
        display: flex;
        align-items: center;
        gap: 18px;
    }
    nav a {
        color: rgba(255, 255, 255, 0.86);
        text-decoration: none;
        font-size: 14px;
    }
    .user-menu-dropdown {
        position: relative;
        display: inline-block;
    }
    .user-menu-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        color: white;
        background: #334155;
        border: none;
        border-radius: 999px;
        padding: 9px 14px;
        cursor: pointer;
    }
    .user-icon {
        width: 18px;
        height: 18px;
    }
    .dropdown-menu {
        position: absolute;
        top: 110%;
        right: 0;
        width: 240px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 16px 40px rgba(15, 23, 42, 0.15);
        padding: 0;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-10px);
        transition: all 0.2s ease;
    }
    .user-menu-dropdown:hover .dropdown-menu {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }
    .dropdown-header {
        padding: 14px 16px;
        border-bottom: 1px solid #e5e7eb;
        font-size: 13px;
        color: #0f172a;
        word-break: break-word;
    }
    .dropdown-item {
        display: block;
        padding: 12px 16px;
        color: #334155;
        text-decoration: none;
        font-size: 14px;
    }
    .dropdown-item:hover {
        background: #f8fafc;
    }
    .password-page {
        min-height: calc(100vh - 88px);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 36px 24px;
    }
    .password-card {
        width: min(560px, 100%);
        background: white;
        padding: 32px;
        border-radius: 24px;
        box-shadow: 0 24px 80px rgba(15, 23, 42, 0.08);
    }
    .password-card h1 {
        margin: 0 0 8px;
        font-size: 28px;
    }
    .subtitle {
        margin: 0 0 24px;
        color: #5b6770;
        line-height: 1.6;
    }
    .form-group {
        margin-bottom: 18px;
        width: 95%;
        max-width: 525px;
    }
    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #0f172a;
    }
    .form-input {
        width: 100%;
        padding: 14px 16px;
        border: 1px solid #cbd5e1;
        border-radius: 14px;
        font-size: 15px;
        background: #f8fafc;
        color: #0f172a;
    }
    .btn-submit {
        width: 100%;
        margin-top: 8px;
        padding: 14px 18px;
        border: none;
        border-radius: 14px;
        background: #4f46e5;
        color: white;
        font-size: 16px;
        cursor: pointer;
    }
    .btn-submit:hover {
        background: #4338ca;
    }
    .validation-summary-errors,
    .success-box {
        padding: 14px 16px;
        border-radius: 14px;
        margin-bottom: 18px;
    }
    .validation-summary-errors {
        background: #f8d7da;
        color: #842029;
        border: 1px solid #f5c2c7;
    }
    .success-box {
        background: #d1fae5;
        color: #065f46;
        border: 1px solid #a7f3d0;
    }
    .err-msg {
        display: block;
        margin-top: 8px;
        color: #b91c1c;
        font-size: 13px;
    }
</style>
</body>
</html>