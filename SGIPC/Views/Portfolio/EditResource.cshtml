@model SGIPC.Models.ResourceEditModel
@{
    ViewBag.Title = "Edit Resource";
    Layout = "~/Views/Portfolio/_Layout.cshtml";
}
<link rel="stylesheet" href='@Url.Content("~/Content/Portfolio/main.css")'>

<section class="page-banner">
    <div class="page-banner-content">
        <h1>Edit Resource</h1>
        <p>Update the title, description, or replace the resource file.</p>
    </div>
</section>

<section class="form-page">
    <div class="form-card">
        @using (Html.BeginForm("UpdateResource", "Portfolio", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)

            <div class="field">
                <label>Title</label>
                @Html.TextBoxFor(m => m.Title, new { @class = "input-field", maxlength = 200, required = "required" })
            </div>
            <div class="field">
                <label>Description</label>
                @Html.TextAreaFor(m => m.Description, 4, 80, new { @class = "input-field" })
            </div>
            <div class="field">
                <label>Replace File (optional)</label>
                <input type="file" name="File" accept="image/*,video/*" />
            </div>
            <button type="submit" class="btn">Update Resource</button>
            <a class="btn secondary" href="@Url.Action("AdminDashboard", "Portfolio")">Cancel</a>
        }
    </div>
</section>
