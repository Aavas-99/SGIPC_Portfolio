@model SGIPC.Models.SignInViewModel
@{
    ViewBag.Title = "Sign In";
    Layout = "~/Views/Portfolio/_Layout.cshtml";
}
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Sora:wght@300;400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href='@Url.Content("~/Content/Portfolio/signin.css")'>

<div class="card">
    <h1>Welcome back</h1>
    <p class="sub">Don't have an account? <a href='@Url.Action("Signup", "Portfolio")'>Sign up</a></p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-message" style="background-color: #10b981; color: white; padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; text-align: center; font-weight: 500;">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="error-message">
            @Html.ValidationSummary(true, "", new { @class = "err" })
        </div>
    }

    @using (Html.BeginForm("Signin", "Portfolio", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="field">
            <label>Email</label>
            @Html.TextBoxFor(m => m.Email, new { @placeholder = "Email Address", @required = "required", @class = "form-control" })
        </div>

        <div class="field">
            <label>Password</label>
            @Html.PasswordFor(m => m.Password, new { @placeholder = "Enter your password", @required = "required", @class = "form-control" })
        </div>

        <div class="row">
            <label class="remember">
                @Html.CheckBoxFor(m => m.RememberMe) Remember me
            </label>
            <a href="#" class="forgot">Forgot password?</a>
        </div>

        <button type="submit" class="btn btn-primary">Sign In</button>
    }
</div>
