@model SGIPC.Models.SignInViewModel
@{
    ViewBag.Title = "Sign In";
    Layout = "~/Views/Portfolio/_Layout.cshtml";
}
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Sora:wght@300;400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href='@Url.Content("~/Content/Portfolio/signin.css")'>

<div class="card">
    <h1>Welcome back</h1>
    <p class="sub">Don't have an account? <a href='@Url.Action("Signup", "Portfolio")'>Sign up</a></p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="background-color:#10b981;color:white;padding:12px 16px;border-radius:8px;margin-bottom:16px;text-align:center;font-weight:500;">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="error-message">
            @foreach (var state in ViewData.ModelState.Values)
            {
                foreach (var error in state.Errors)
                {
                    if (!string.IsNullOrWhiteSpace(error.ErrorMessage))
                    {
                        <div class="err">@error.ErrorMessage</div>
                    }
                }
            }
        </div>
    }

    @using (Html.BeginForm("Signin", "Portfolio", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="field">
            <label>Email</label>
            @Html.TextBoxFor(m => m.Email, new { @placeholder = "Email Address", @class = "form-control" })
        </div>

        <div class="field">
            <label>Password</label>
            @Html.PasswordFor(m => m.Password, new { @placeholder = "Enter your password", @class = "form-control" })
        </div>

        <div class="field">
            <label>Account type</label>
            <div class="login-type-toggle">
                <button type="button" class="toggle-btn active" id="btnUser" onclick="setLoginType(false)">User</button>
                <button type="button" class="toggle-btn" id="btnAdmin" onclick="setLoginType(true)">Admin</button>
            </div>
            @* Plain hidden input — always posts true/false reliably *@
            <input type="hidden" name="IsAdmin" id="isAdminHidden" value="false" />
        </div>

        <div class="row">
            <label class="remember">
                <input type="checkbox" name="RememberMe" id="rememberMe" value="true" />
                Remember me
            </label>
        </div>

        <button type="submit" class="btn btn-primary">Sign In</button>
    }
</div>

<script>
    function setLoginType(isAdmin) {
        document.getElementById('isAdminHidden').value = isAdmin ? 'true' : 'false';
        document.getElementById('btnUser').classList.toggle('active', !isAdmin);
        document.getElementById('btnAdmin').classList.toggle('active', isAdmin);
    }
</script>