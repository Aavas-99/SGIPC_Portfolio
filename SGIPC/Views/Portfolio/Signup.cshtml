@model SGIPC.Models.SignUpViewModel
@{
    ViewBag.Title = "Sign Up";
    Layout = "~/Views/Portfolio/_Layout.cshtml";
}
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Sora:wght@300;400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href='@Url.Content("~/Content/Portfolio/signup.css")'>

<div class="card">
    <h1>Create account</h1>
    <p class="sub">Already a member? <a href='@Url.Action("Signin", "Portfolio")'>Sign in</a></p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="error-message">
            @Html.ValidationSummary(true, "", new { @class = "err" })
        </div>
    }

    @using (Html.BeginForm("Signup", "Portfolio", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="field">
            <label>Email</label>
            @Html.TextBoxFor(m => m.Email, new { @placeholder = "Email Address", @required = "required", @class = "form-control" })
        </div>

        <div class="field">
            <label>Password</label>
            @Html.PasswordFor(m => m.Password, new { @placeholder = "Create a strong password", @required = "required", @class = "form-control", @oninput = "checkStrength(this.value)" })
            <div class="strength-bar">
                <span id="s1"></span>
                <span id="s2"></span>
                <span id="s3"></span>
                <span id="s4"></span>
            </div>
            <div class="strength-label" id="strength-label"></div>
        </div>

        <div class="field">
            <label>Confirm Password</label>
            @Html.PasswordFor(m => m.Confirm, new { @placeholder = "Repeat your password", @required = "required", @class = "form-control" })
            <div class="err" id="pw-err">Passwords do not match.</div>
        </div>

        <button type="submit" class="btn btn-primary">Create Account</button>
    }
</div>

<script src='@Url.Content("~/Scripts/Portfolio/signup.js")'></script>
<script>
    function checkStrength(password) {
        let strength = 0;
        const strengthSpans = document.querySelectorAll('.strength-bar span');
        const label = document.getElementById('strength-label');

        if (password.length >= 8) strength++;
        if (/[a-z]/.test(password) && /[A-Z]/.test(password)) strength++;
        if (/[0-9]/.test(password)) strength++;
        if (/[^a-zA-Z0-9]/.test(password)) strength++;

        strengthSpans.forEach((span, index) => {
            if (index < strength) {
                span.style.backgroundColor = strength === 4 ? '#28a745' : strength === 3 ? '#ffc107' : '#dc3545';
            } else {
                span.style.backgroundColor = '#e0e0e0';
            }
        });

        const labels = ['Very Weak', 'Weak', 'Fair', 'Strong', 'Very Strong'];
        label.textContent = labels[strength];
    }
</script>
