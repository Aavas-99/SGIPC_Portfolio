@model List<SGIPC.Models.AnnouncementViewModel>
@{
    ViewBag.Title = "Announcements";
    Layout = "~/Views/Portfolio/_Layout.cshtml";
}
<link rel="stylesheet" href='@Url.Content("~/Content/Portfolio/main.css")'>
<link rel="stylesheet" href='@Url.Content("~/Content/Portfolio/Announcements.css")'>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<section class="page-banner">
    <div class="page-banner-content">
        <h1>Announcements</h1>
        <p>Stay updated with the latest news, workshops, and club announcements.</p>
    </div>
</section>

<section class="cards-section">
    @if (Model.Count == 0)
    {
        <div class="empty-card">No announcements are available right now. Please check back later.</div>
    }
    else
    {
        <div class="card-grid">
            @foreach (var announcement in Model)
            {
                <article class="info-card announcement-card">
                    <div class="card-head">
                        <h2>@announcement.Title</h2>
                        <span>@announcement.CreatedAt.ToString("dd MMM yyyy")</span>
                    </div>
                    <p>@announcement.Content</p>
                </article>
            }
        </div>
    }
</section>
