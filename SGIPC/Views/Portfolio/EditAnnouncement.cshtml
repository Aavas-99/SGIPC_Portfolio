@model SGIPC.Models.AnnouncementEditModel
@{
    ViewBag.Title = "Edit Announcement";
    Layout = "~/Views/Portfolio/_Layout.cshtml";
}
<link rel="stylesheet" href='@Url.Content("~/Content/Portfolio/main.css")'>

<section class="page-banner">
    <div class="page-banner-content">
        <h1>Edit Announcement</h1>
        <p>Refresh the announcement text for club members.</p>
    </div>
</section>

<section class="form-page">
    <div class="form-card">
        @using (Html.BeginForm("UpdateAnnouncement", "Portfolio", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)

            <div class="field">
                <label>Title</label>
                @Html.TextBoxFor(m => m.Title, new { @class = "input-field", maxlength = 200, required = "required" })
            </div>
            <div class="field">
                <label>Content</label>
                @Html.TextAreaFor(m => m.Content, 5, 80, new { @class = "input-field", required = "required" })
            </div>
            <button type="submit" class="btn">Save Announcement</button>
            <button type="button" class="btn" onclick="window.location='@Url.Action("AdminDashboard", "Portfolio")'">Cancel</button>
        }
    </div>
</section>
